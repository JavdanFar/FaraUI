{
  "name": "fara-ui",
  "version": "0.3.1",
  "description": "RTL-first React UI component library for Persian applications",
  "keywords": [
    "react",
    "ui",
    "component-library",
    "rtl",
    "persian",
    "jalali"
  ],
  "author": "Faramarz Javdan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JavdanFar/FaraUI.git"
  },
  "homepage": "https://github.com/JavdanFar/FaraUI#readme",
  "bugs": {
    "url": "https://github.com/JavdanFar/FaraUI/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./jalali": {
      "types": "./dist/entry-points/jalali.d.ts",
      "import": "./dist/jalali.js",
      "require": "./dist/jalali.cjs"
    },
    "./styles.css": "./dist/fara-ui.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview"
  },
  "dependencies": {
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1",
    "vite-plugin-dts": "^5.0.3"
  }
}
